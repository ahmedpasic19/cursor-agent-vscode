{
  "name": "cursor-agent-vscode",
  "displayName": "Cursor Agent",
  "description": "Cursor's agent in a VS Code sidebar chat, laid out like Claude Code.",
  "version": "0.11.3",
  "publisher": "local",
  "icon": "media/logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmedpasic19/cursor-agent-vscode.git"
  },
  "homepage": "https://github.com/ahmedpasic19/cursor-agent-vscode#readme",
  "type": "module",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22.18.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.cjs",
  "files": [
    "dist/extension.cjs",
    "dist/sdk-worker.cjs",
    "dist/webview/index.js",
    "dist/webview/index.css",
    "dist/webview/sessions.js",
    "dist/webview/sessions.css",
    "media/icon.svg",
    "media/logo.png",
    "README.md"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursorAgent",
          "title": "Cursor",
          "icon": "media/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "cursorAgentChat",
          "title": "Cursor",
          "icon": "media/icon.svg",
          "when": "!cursorAgent:noSecondarySidebar"
        }
      ]
    },
    "views": {
      "cursorAgent": [
        {
          "type": "webview",
          "id": "cursorAgent.sessions",
          "name": "Sessions"
        },
        {
          "id": "cursorAgent.mcp",
          "name": "MCP & Plugins",
          "icon": "$(plug)",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "cursorAgent.chatSidebar",
          "name": "Chat",
          "when": "cursorAgent:noSecondarySidebar"
        }
      ],
      "cursorAgentChat": [
        {
          "type": "webview",
          "id": "cursorAgent.chat",
          "name": "Cursor",
          "when": "!cursorAgent:noSecondarySidebar"
        }
      ]
    },
    "commands": [
      {
        "command": "cursorAgent.openSettings",
        "title": "Open Settings",
        "category": "Cursor Agent",
        "icon": "$(gear)"
      },
      {
        "command": "cursorAgent.newChat",
        "title": "New Chat",
        "category": "Cursor Agent",
        "icon": "$(add)"
      },
      {
        "command": "cursorAgent.focusChat",
        "title": "Focus Chat",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.stop",
        "title": "Stop Current Run",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.showLog",
        "title": "Show Log",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.login",
        "title": "Log In to Cursor",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.addSelectionToChat",
        "title": "Add to Cursor",
        "category": "Cursor Agent",
        "icon": "$(sparkle)"
      },
      {
        "command": "cursorAgent.addFileToChat",
        "title": "Add File to Cursor",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.addTerminalSelectionToChat",
        "title": "Add Terminal Output to Chat",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.addProblemsToChat",
        "title": "Add Problems to Chat",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.addWorkspaceProblemsToChat",
        "title": "Add All Workspace Problems to Chat",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.showHistory",
        "title": "Show Sessions",
        "category": "Cursor Agent",
        "icon": "$(history)"
      },
      {
        "command": "cursorAgent.installSdk",
        "title": "Install SDK Backend",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.setSdkApiKey",
        "title": "Set API Key",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.clearSdkApiKey",
        "title": "Clear API Key",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.focusSessions",
        "title": "Focus Session Manager",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.newGroup",
        "title": "New Session Group",
        "category": "Cursor Agent",
        "icon": "$(new-folder)"
      },
      {
        "command": "cursorAgent.refreshAccount",
        "title": "Refresh Account & Usage",
        "category": "Cursor Agent",
        "icon": "$(refresh)"
      },
      {
        "command": "cursorAgent.mcp.refresh",
        "title": "Refresh MCP Servers",
        "category": "Cursor Agent",
        "icon": "$(refresh)"
      },
      {
        "command": "cursorAgent.mcp.add",
        "title": "Add MCP Server…",
        "category": "Cursor Agent",
        "icon": "$(add)"
      },
      {
        "command": "cursorAgent.mcp.edit",
        "title": "Edit MCP Server",
        "category": "Cursor Agent",
        "icon": "$(edit)"
      },
      {
        "command": "cursorAgent.mcp.remove",
        "title": "Remove MCP Server",
        "category": "Cursor Agent",
        "icon": "$(trash)"
      },
      {
        "command": "cursorAgent.mcp.enable",
        "title": "Enable MCP Server",
        "category": "Cursor Agent",
        "icon": "$(play)"
      },
      {
        "command": "cursorAgent.mcp.disable",
        "title": "Disable MCP Server",
        "category": "Cursor Agent",
        "icon": "$(circle-slash)"
      },
      {
        "command": "cursorAgent.mcp.login",
        "title": "Log In to MCP Server",
        "category": "Cursor Agent",
        "icon": "$(key)"
      },
      {
        "command": "cursorAgent.mcp.openConfig",
        "title": "Open MCP Config",
        "category": "Cursor Agent",
        "icon": "$(go-to-file)"
      },
      {
        "command": "cursorAgent.mcp.openGlobalConfig",
        "title": "Open Global MCP Config (~/.cursor/mcp.json)",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.mcp.toggleApprove",
        "title": "Toggle Auto-approve MCP Servers",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.plugins.addMarketplace",
        "title": "Add Plugin Marketplace…",
        "category": "Cursor Agent",
        "icon": "$(add)"
      },
      {
        "command": "cursorAgent.plugins.removeMarketplace",
        "title": "Remove Plugin Marketplace",
        "category": "Cursor Agent",
        "icon": "$(trash)"
      },
      {
        "command": "cursorAgent.plugins.updateMarketplace",
        "title": "Update Plugin Marketplace",
        "category": "Cursor Agent",
        "icon": "$(sync)"
      },
      {
        "command": "cursorAgent.plugins.addDir",
        "title": "Add Local Plugin Folder…",
        "category": "Cursor Agent",
        "icon": "$(add)"
      },
      {
        "command": "cursorAgent.plugins.removeDir",
        "title": "Remove Local Plugin Folder",
        "category": "Cursor Agent",
        "icon": "$(close)"
      },
      {
        "command": "cursorAgent.plugins.reveal",
        "title": "Reveal Plugin Folder",
        "category": "Cursor Agent",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cursorAgent.newChat",
          "when": "view == cursorAgent.sessions",
          "group": "navigation@1"
        },
        {
          "command": "cursorAgent.newGroup",
          "when": "view == cursorAgent.sessions",
          "group": "navigation@2"
        },
        {
          "command": "cursorAgent.refreshAccount",
          "when": "view == cursorAgent.sessions",
          "group": "navigation@3"
        },
        {
          "command": "cursorAgent.openSettings",
          "when": "view == cursorAgent.sessions",
          "group": "navigation@4"
        },
        {
          "command": "cursorAgent.mcp.add",
          "when": "view == cursorAgent.mcp",
          "group": "navigation@1"
        },
        {
          "command": "cursorAgent.mcp.refresh",
          "when": "view == cursorAgent.mcp",
          "group": "navigation@2"
        },
        {
          "command": "cursorAgent.mcp.openConfig",
          "when": "view == cursorAgent.mcp",
          "group": "navigation@3"
        },
        {
          "command": "cursorAgent.plugins.addMarketplace",
          "when": "view == cursorAgent.mcp",
          "group": "plugins@1"
        },
        {
          "command": "cursorAgent.plugins.addDir",
          "when": "view == cursorAgent.mcp",
          "group": "plugins@2"
        }
      ],
      "editor/context": [
        {
          "command": "cursorAgent.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "cursorAgent@1"
        },
        {
          "command": "cursorAgent.addFileToChat",
          "when": "!editorHasSelection",
          "group": "cursorAgent@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "cursorAgent.addFileToChat",
          "group": "cursorAgent@1"
        }
      ],
      "explorer/context": [
        {
          "command": "cursorAgent.addFileToChat",
          "group": "cursorAgent@1"
        }
      ],
      "terminal/context": [
        {
          "command": "cursorAgent.addTerminalSelectionToChat",
          "group": "cursorAgent@1"
        }
      ],
      "problems/context": [
        {
          "command": "cursorAgent.addProblemsToChat",
          "group": "cursorAgent@1"
        }
      ],
      "commandPalette": [
        {
          "command": "cursorAgent.addSelectionToChat",
          "when": "editorIsOpen"
        },
        {
          "command": "cursorAgent.addFileToChat",
          "when": "editorIsOpen"
        },
        {
          "command": "cursorAgent.mcp.edit",
          "when": "false"
        },
        {
          "command": "cursorAgent.mcp.remove",
          "when": "false"
        },
        {
          "command": "cursorAgent.mcp.enable",
          "when": "false"
        },
        {
          "command": "cursorAgent.mcp.disable",
          "when": "false"
        },
        {
          "command": "cursorAgent.mcp.login",
          "when": "false"
        },
        {
          "command": "cursorAgent.plugins.removeMarketplace",
          "when": "false"
        },
        {
          "command": "cursorAgent.plugins.updateMarketplace",
          "when": "false"
        },
        {
          "command": "cursorAgent.plugins.removeDir",
          "when": "false"
        },
        {
          "command": "cursorAgent.plugins.reveal",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "cursorAgent.mcp.login",
          "when": "view == cursorAgent.mcp && viewItem =~ /^mcpServer.*\\.auth/",
          "group": "inline@1"
        },
        {
          "command": "cursorAgent.mcp.enable",
          "when": "view == cursorAgent.mcp && viewItem =~ /^mcpServer\\.disabled/",
          "group": "inline@2"
        },
        {
          "command": "cursorAgent.mcp.disable",
          "when": "view == cursorAgent.mcp && viewItem =~ /^mcpServer\\.enabled/",
          "group": "inline@2"
        },
        {
          "command": "cursorAgent.mcp.edit",
          "when": "view == cursorAgent.mcp && viewItem =~ /^mcpServer/",
          "group": "inline@3"
        },
        {
          "command": "cursorAgent.mcp.enable",
          "when": "view == cursorAgent.mcp && viewItem =~ /^mcpServer\\.disabled/",
          "group": "1_state@1"
        },
        {
          "command": "cursorAgent.mcp.disable",
          "when": "view == cursorAgent.mcp && viewItem =~ /^mcpServer\\.enabled/",
          "group": "1_state@1"
        },
        {
          "command": "cursorAgent.mcp.login",
          "when": "view == cursorAgent.mcp && viewItem =~ /^mcpServer/",
          "group": "1_state@2"
        },
        {
          "command": "cursorAgent.mcp.edit",
          "when": "view == cursorAgent.mcp && viewItem =~ /^mcpServer/",
          "group": "2_edit@1"
        },
        {
          "command": "cursorAgent.mcp.openConfig",
          "when": "view == cursorAgent.mcp && viewItem =~ /^mcpServer/",
          "group": "2_edit@2"
        },
        {
          "command": "cursorAgent.mcp.remove",
          "when": "view == cursorAgent.mcp && viewItem =~ /^mcpServer/",
          "group": "3_remove@1"
        },
        {
          "command": "cursorAgent.mcp.add",
          "when": "view == cursorAgent.mcp && viewItem == section.servers",
          "group": "inline@1"
        },
        {
          "command": "cursorAgent.plugins.addMarketplace",
          "when": "view == cursorAgent.mcp && viewItem == group.marketplaces",
          "group": "inline@1"
        },
        {
          "command": "cursorAgent.plugins.addDir",
          "when": "view == cursorAgent.mcp && viewItem == group.pluginDirs",
          "group": "inline@1"
        },
        {
          "command": "cursorAgent.plugins.updateMarketplace",
          "when": "view == cursorAgent.mcp && viewItem == marketplace",
          "group": "inline@1"
        },
        {
          "command": "cursorAgent.plugins.removeMarketplace",
          "when": "view == cursorAgent.mcp && viewItem == marketplace",
          "group": "inline@2"
        },
        {
          "command": "cursorAgent.plugins.reveal",
          "when": "view == cursorAgent.mcp && viewItem =~ /^(plugin|pluginDir)$/",
          "group": "inline@1"
        },
        {
          "command": "cursorAgent.plugins.removeDir",
          "when": "view == cursorAgent.mcp && viewItem == pluginDir",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cursorAgent.addSelectionToChat",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "cursorAgent.focusChat",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "!(editorTextFocus && editorHasSelection)"
      },
      {
        "command": "cursorAgent.addFileToChat",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "cursorAgent.addTerminalSelectionToChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "terminalFocus"
      }
    ],
    "configuration": {
      "title": "Cursor Agent",
      "properties": {
        "cursorAgent.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the cursor-agent CLI (or its node.exe). Empty = auto-detect."
        },
        "cursorAgent.backend": {
          "type": "string",
          "enum": [
            "cli",
            "sdk"
          ],
          "enumDescriptions": [
            "cursor-agent CLI with your Cursor subscription login (default).",
            "@cursor/sdk with an API key, billed by usage. Needs Node 22.13+ and a one-time install."
          ],
          "default": "cli",
          "description": "Which agent runtime to use."
        },
        "cursorAgent.cli.useApiKey": {
          "type": "boolean",
          "default": false,
          "description": "CLI backend only: authenticate with the Cursor API key saved by \"Cursor Agent: Set API Key\" (passed as CURSOR_API_KEY) instead of the CLI's own login. Easiest to change in the Settings section of the Cursor sidebar."
        },
        "cursorAgent.sdk.nodePath": {
          "type": "string",
          "default": "",
          "description": "Node executable for the SDK backend (needs 22.13+). Empty = `node` on PATH."
        },
        "cursorAgent.defaultMode": {
          "type": "string",
          "enum": [
            "agent",
            "ask",
            "plan"
          ],
          "default": "agent",
          "description": "Mode for new messages in a new tab."
        },
        "cursorAgent.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Model for new tabs. Empty = CLI default."
        },
        "cursorAgent.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Fallback model list for the selector, used when `cursor-agent models` fails."
        },
        "cursorAgent.maxConcurrentRuns": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Maximum number of runs executing at once."
        },
        "cursorAgent.runTimeoutMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Hard kill timeout per run."
        },
        "cursorAgent.postResultGraceMs": {
          "type": "number",
          "default": 3000,
          "minimum": 0,
          "description": "Wait this long after the `result` event, then kill the process if it is still alive."
        },
        "cursorAgent.checkpoints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Take shadow-git checkpoints before Agent runs."
        },
        "cursorAgent.checkpoints.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra exclude globs for checkpoints."
        },
        "cursorAgent.context.maxChipLines": {
          "type": "number",
          "default": 2000,
          "description": "Maximum lines per context chip."
        },
        "cursorAgent.streamPartialOutput": {
          "type": "boolean",
          "default": true,
          "description": "Use --stream-partial-output for token-by-token streaming."
        },
        "cursorAgent.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments appended to every cursor-agent invocation."
        },
        "cursorAgent.historyLimit": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "description": "Maximum saved chats per workspace; the oldest closed chats are deleted first."
        },
        "cursorAgent.usage.dailyTokenBudget": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Optional daily token budget. When set, Account & Usage draws bars for today and the last 7 days against it. 0 = show plain totals. These are tokens used through this extension, not your Cursor plan quota."
        },
        "cursorAgent.showActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "Show the file and selection you are looking at above the composer, as pills that attach them to the chat when clicked."
        },
        "cursorAgent.selectionCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show an \"Add to Cursor (Ctrl+I)\" CodeLens above the editor selection."
        },
        "cursorAgent.approveMcps": {
          "type": "boolean",
          "default": false,
          "description": "Pass --approve-mcps to every run so configured MCP servers load without an approval prompt. Toggle it in the MCP & Plugins view."
        },
        "cursorAgent.pluginDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Local plugin folders passed to every run with --plugin-dir."
        },
        "cursorAgent.skills.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Discover Cursor skills and custom slash commands for the / menu and prompt expansion."
        },
        "cursorAgent.skills.extraDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra directories to scan for SKILL.md folders (absolute paths, or relative to $HOME when not absolute)."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "node esbuild.mjs",
    "build:webview": "vite build --config webview-ui/vite.config.ts && vite build --config webview-ui/vite.sessions.config.ts",
    "watch:ext": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview-ui/tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "npm run typecheck && npm test && npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "record": "node scripts/record.ts",
    "record:agent": "node scripts/record-agent-cases.ts",
    "test:integration": "npm run build && node test/integration/runTest.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.100.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^3.23.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.16"
  }
}
