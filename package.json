{
  "name": "cursor-agent-vscode",
  "displayName": "Cursor Agent",
  "description": "Cursor's agent in a VS Code sidebar chat (personal use).",
  "version": "0.7.0",
  "publisher": "local",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22.18.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.cjs",
  "files": [
    "dist/extension.cjs",
    "dist/sdk-worker.cjs",
    "dist/webview/index.js",
    "dist/webview/index.css",
    "media/icon.svg",
    "README.md"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursorAgent",
          "title": "Cursor Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cursorAgent": [
        {
          "type": "webview",
          "id": "cursorAgent.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "cursorAgent.newChat",
        "title": "New Chat",
        "category": "Cursor Agent",
        "icon": "$(add)"
      },
      {
        "command": "cursorAgent.focusChat",
        "title": "Focus Chat",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.stop",
        "title": "Stop Current Run",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.showLog",
        "title": "Show Log",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.login",
        "title": "Log In to Cursor",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.addSelectionToChat",
        "title": "Add Selection to Chat",
        "category": "Cursor Agent",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "cursorAgent.addFileToChat",
        "title": "Add File to Chat",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.addTerminalSelectionToChat",
        "title": "Add Terminal Output to Chat",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.addProblemsToChat",
        "title": "Add Problems to Chat",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.addWorkspaceProblemsToChat",
        "title": "Add All Workspace Problems to Chat",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.showHistory",
        "title": "Show Chat History",
        "category": "Cursor Agent",
        "icon": "$(history)"
      },
      {
        "command": "cursorAgent.installSdk",
        "title": "Install SDK Backend",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.setSdkApiKey",
        "title": "Set SDK API Key",
        "category": "Cursor Agent"
      },
      {
        "command": "cursorAgent.clearSdkApiKey",
        "title": "Clear SDK API Key",
        "category": "Cursor Agent"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cursorAgent.newChat",
          "when": "view == cursorAgent.chat",
          "group": "navigation@1"
        },
        {
          "command": "cursorAgent.showHistory",
          "when": "view == cursorAgent.chat",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "cursorAgent.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "cursorAgent@1"
        },
        {
          "command": "cursorAgent.addFileToChat",
          "when": "!editorHasSelection",
          "group": "cursorAgent@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "cursorAgent.addFileToChat",
          "group": "cursorAgent@1"
        }
      ],
      "explorer/context": [
        {
          "command": "cursorAgent.addFileToChat",
          "group": "cursorAgent@1"
        }
      ],
      "terminal/context": [
        {
          "command": "cursorAgent.addTerminalSelectionToChat",
          "group": "cursorAgent@1"
        }
      ],
      "problems/context": [
        {
          "command": "cursorAgent.addProblemsToChat",
          "group": "cursorAgent@1"
        }
      ],
      "commandPalette": [
        {
          "command": "cursorAgent.addSelectionToChat",
          "when": "editorIsOpen"
        },
        {
          "command": "cursorAgent.addFileToChat",
          "when": "editorIsOpen"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cursorAgent.focusChat",
        "key": "ctrl+i",
        "mac": "cmd+i"
      },
      {
        "command": "cursorAgent.addSelectionToChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "cursorAgent.addFileToChat",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "cursorAgent.addTerminalSelectionToChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "terminalFocus"
      }
    ],
    "configuration": {
      "title": "Cursor Agent",
      "properties": {
        "cursorAgent.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the cursor-agent CLI (or its node.exe). Empty = auto-detect."
        },
        "cursorAgent.backend": {
          "type": "string",
          "enum": [
            "cli",
            "sdk"
          ],
          "enumDescriptions": [
            "cursor-agent CLI with your Cursor subscription login (default).",
            "@cursor/sdk with an API key, billed by usage. Needs Node 22.13+ and a one-time install."
          ],
          "default": "cli",
          "description": "Which agent runtime to use."
        },
        "cursorAgent.sdk.nodePath": {
          "type": "string",
          "default": "",
          "description": "Node executable for the SDK backend (needs 22.13+). Empty = `node` on PATH."
        },
        "cursorAgent.defaultMode": {
          "type": "string",
          "enum": [
            "agent",
            "ask",
            "plan"
          ],
          "default": "agent",
          "description": "Mode for new messages in a new tab."
        },
        "cursorAgent.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Model for new tabs. Empty = CLI default."
        },
        "cursorAgent.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Fallback model list for the selector, used when `cursor-agent models` fails."
        },
        "cursorAgent.maxConcurrentRuns": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Maximum number of runs executing at once."
        },
        "cursorAgent.runTimeoutMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Hard kill timeout per run."
        },
        "cursorAgent.postResultGraceMs": {
          "type": "number",
          "default": 3000,
          "minimum": 0,
          "description": "Wait this long after the `result` event, then kill the process if it is still alive."
        },
        "cursorAgent.checkpoints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Take shadow-git checkpoints before Agent runs."
        },
        "cursorAgent.checkpoints.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra exclude globs for checkpoints."
        },
        "cursorAgent.context.maxChipLines": {
          "type": "number",
          "default": 2000,
          "description": "Maximum lines per context chip."
        },
        "cursorAgent.streamPartialOutput": {
          "type": "boolean",
          "default": true,
          "description": "Use --stream-partial-output for token-by-token streaming."
        },
        "cursorAgent.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments appended to every cursor-agent invocation."
        },
        "cursorAgent.historyLimit": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "description": "Maximum saved chats per workspace; the oldest closed chats are deleted first."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "node esbuild.mjs",
    "build:webview": "vite build --config webview-ui/vite.config.ts",
    "watch:ext": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview-ui/tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "npm run typecheck && npm test && npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "record": "node scripts/record.ts",
    "record:agent": "node scripts/record-agent-cases.ts",
    "test:integration": "npm run build && node test/integration/runTest.mjs"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.100.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^3.23.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.16"
  }
}
